Checkout-specific reCAPTCHA templates.
Login/signup/reset are handled by portal_templates.xml.
Contact Us is handled by website_form_templates.xml.
-->
<odoo>

    <!-- Checkout Address Form -->
    <template id="checkout_recaptcha" inherit_id="website_sale.address" name="reCAPTCHA v2 - Checkout Address">
        <xpath expr="//button[hasclass('a-submit')]" position="before">
            <t t-if="request.website.recaptcha_v2_enabled">
                <div class="form-group">
                    <div
                        class="g-recaptcha"
                        t-att-data-sitekey="request.website.recaptcha_v2_site_key"
                    />
                </div>
            </t>
        </xpath>
        <!-- Disable the Next button until reCAPTCHA is completed -->
        <xpath expr="//button[hasclass('a-submit')]" position="replace">
            <t t-if="request.website.recaptcha_v2_enabled">
                <button
                    type="submit"
                    id="recaptcha_submit"
                    class="btn btn-primary mb32 a-submit a-submit-disable a-submit-loading"
                    disabled="disabled"
                >Next</button>
            </t>
            <t t-else="">
                <button
                    type="submit"
                    class="btn btn-primary mb32 a-submit a-submit-disable a-submit-loading"
                >Next</button>
            </t>
        </xpath>
    </template>

</odoo>
