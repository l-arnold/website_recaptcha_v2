Reusable reCAPTCHA v2 widget snippet.
Call with: <t t-call="website_recaptcha_v2.recaptcha_widget"/>
The Google API script is loaded here; individual forms do NOT need to load it.
-->
<odoo>

    <template id="recaptcha_widget" name="reCAPTCHA v2 Widget">
        <t t-if="website.recaptcha_v2_enabled">
            <script
                src="https://www.recaptcha.net/recaptcha/api.js"
                async="async"
                defer="defer"
            />
            <div
                class="g-recaptcha"
                t-att-data-sitekey="website.recaptcha_v2_site_key"
            />
        </t>
    </template>

</odoo>
